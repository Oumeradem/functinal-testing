{
  "name": "sep-automation-ts",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
  "test": "npx cucumber-js --format json:reports/cucumber.json",
  "test:tag": "npx cucumber-js --tags @sep10 --format json:reports/cucumber.json",
  "test:tag:dryrun": "npx cucumber-js --tags @sep10-4 --dry-run",
  "test:smoke": "npx cucumber-js --tags @smoke --format json:reports/cucumber.json",

  "test:playwright": "npx playwright test",
  "test:cucumber": "npx cucumber-js --format json:reports/cucumber.json",
  "test:ci": "npm run test:playwright && npm run test:cucumber",

  "Mac-open:report": "open reports/cucumber-report.html",
  "Windows-open:report": "start reports/cucumber-report.html"
  
},

  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@cucumber/cucumber": "^10.9.0",
    "@faker-js/faker": "^10.2.0",
    "@playwright/test": "^1.57.0",
    "@types/node": "^20.19.27",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/cucumber": "^6.0.1"
  }
}
